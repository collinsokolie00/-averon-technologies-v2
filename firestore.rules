rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['owner', 'admin'];
    }

    function ownsCustomerField() {
      return signedIn() && request.resource.data.customerId == request.auth.uid;
    }

    function ownsExistingCustomerField() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid;
      allow read, update: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow list, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow create: if false;
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow create, delete: if isAdmin();
      // Contract lifecycle writes go through the authenticated API only.
      allow update: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      // Association and sender identity are assigned by the API.
      allow create: if false;
      allow read: if isAdmin() || (ownsExistingCustomerField()
        && (!('projectId' in resource.data)
          || (get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.customerId == request.auth.uid
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.accessEnabled == true
            && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.unlockedAt != null)));
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{auditLogId} {
      allow read, write: if isAdmin();
    }
  }
}
