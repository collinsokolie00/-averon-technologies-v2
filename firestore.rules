rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['owner', 'admin'];
    }

    function ownsCustomerField() {
      return signedIn() && request.resource.data.customerId == request.auth.uid;
    }

    function ownsExistingCustomerField() {
      return signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && userId == request.auth.uid;
      allow read, update: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow list, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow create: if ownsCustomerField();
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          ownsExistingCustomerField()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'signedBy',
            'typedSignature',
            'signedAt',
            'updatedAt',
            'audit'
          ])
          && request.resource.data.signedBy == request.auth.uid
        );
    }

    match /invoices/{invoiceId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if ownsCustomerField() || isAdmin();
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if ownsExistingCustomerField() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{auditLogId} {
      allow read, write: if isAdmin();
    }
  }
}
