# Server runtime
PORT=8787
API_VERSION=0.1.0
API_BUILD=
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SHUTDOWN_TIMEOUT_MS=10000
AI_DIAGNOSTICS_MAX_ENTRIES=100
AI_DIAGNOSTICS_RETENTION_DAYS=7

# Server-only Firebase Admin configuration. Use application-default credentials or a secret manager.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CONFIG=

# Backend-private integrations.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TIMEOUT_MS=20000
PAYMENT_FRONTEND_ORIGIN=http://localhost:5173
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=20000
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=12000
# Deployment-owned metadata (optional)
GOOGLE_CLOUD_PROJECT=
